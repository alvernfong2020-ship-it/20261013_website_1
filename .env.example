# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/scrollystory?schema=public"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# AI generation (optional). Leave AI_PROVIDER blank to run in explicit DEMO mode.
# AI_PROVIDER accepts: openai | anthropic
# ---------------------------------------------------------------------------
AI_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# ---------------------------------------------------------------------------
# Object storage (optional - local disk adapter used when STORAGE_DRIVER=local)
# STORAGE_DRIVER accepts: local | s3
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Billing (optional - clearly-labelled development billing mode used when blank)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Forms / abuse protection
# ---------------------------------------------------------------------------
FORM_RATE_LIMIT_PER_HOUR="20"
